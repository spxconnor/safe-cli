#!/usr/bin/env python3
"""bash_verify CLI entry point.

Self-bootstrapping: adds the parent directory of this script to sys.path
so that `import bv.cli` works regardless of the caller's cwd.
"""
import sys
from pathlib import Path

# /opt/bash-verifier/bin/bash_verify -> /opt/bash-verifier/bin -> /opt/bash-verifier
PKG_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PKG_ROOT))

from bv.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
